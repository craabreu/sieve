# COSMO segment stores
stores/

# Draft markdown files
drafts/

# Jupyter notebook for experimenting with sieve
sieve_*.ipynb

# VSCode
.vscode/

# UV lock files
uv.lock

# Experiment outputs and external checkout for the experiments series
# (see experiments/README.md). The data physically lives under
# charge_experiments/ (only the leaf dirs below are listed, not
# charge_experiments/ itself, since git cannot un-ignore a file inside an
# ignored directory) and is reached from the experiments/ package tree via
# symlinks -- so those symlink names are listed too, or git would try to
# stage them as new paths.
charge_experiments/runs/
charge_experiments/mlflow_runs.db
charge_experiments/mlflow_runs.db-*
charge_experiments/mlflow_artifacts/
charge_experiments/cache/
charge_experiments/results/
charge_experiments/stores/
charge_experiments/external/
charge_experiments/artifacts/

# Experiment outputs reached through experiments/ (symlinks into
# charge_experiments/, which still physically holds the data).
experiments/runs
experiments/mlflow_runs.db
experiments/mlflow_artifacts
experiments/cache
experiments/results
experiments/stores
experiments/external

# Study figures. Regenerable from experiments/runs by the depth-curve and
# compare steps, and not what the manuscript ships -- main.tex builds its own
# from sieve_paper/figures. Tracking them cost 9.1 MB of blobs across 10
# commits and, because every fitting entry point refuses a dirty tree, made
# each figure-producing step abort the step that followed it.
experiments/docs/figures/

# cosmo_experiments/ isn't part of this branch (it lives on experiments/
# dash-charges) -- ignored here so a shared checkout's leftover copy never
# gets accidentally staged on this branch.
cosmo_experiments/

# Python
.venv/
.venv311/
__pycache__/
*.egg-info/
.pytest_cache/
tmp/

# Pre-collapse artifacts, moved aside for the corpus rebuild (2026-09-17).
# Superseded by the collapsed-corpus run; kept only until that validates.
experiments/backup-precollapse
# Reports (metrics, manifests, logs) of the runs on the pre-bond-fix store,
# kept for comparison before those runs are wiped (2026-09-23).
experiments/backup-prebondfix
